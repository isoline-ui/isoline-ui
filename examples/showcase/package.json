{
  "name": "isoline-showcase",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios --max-workers 2 --output-dir dist/ios",
    "export:android": "expo export --platform android --max-workers 2 --output-dir dist/android",
    "export:web": "expo export --platform web --max-workers 2 --output-dir dist/web",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "^58.0.16",
    "@isoline-ui/native": "2.0.0",
    "@isoline-ui/react-native": "2.0.0",
    "expo": "~58.0.14",
    "expo-font": "~58.0.0",
    "expo-glass-effect": "~58.0.5",
    "expo-system-ui": "~58.0.0",
    "nativewind": "^4.2.6",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  }
}
