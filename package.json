{
  "name": "isoline-ui-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @isoline-ui/react-native",
    "typecheck": "npm run typecheck --workspace @isoline-ui/react-native",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-package.mjs",
    "pack": "npm run build && npm pack --workspace @isoline-ui/react-native",
    "showcase": "npm run start --workspace isoline-showcase"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/node": "^26.3.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "nativewind": "^4.2.6",
    "prettier": "^3.9.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
