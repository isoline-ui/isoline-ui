{
  "name": "@isoline-ui/react-native",
  "version": "1.0.0",
  "description": "Shared expressive React Native components with platform-aware interaction",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/isoline-ui/isoline-ui.git",
    "directory": "packages/react-native"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./src/theme.ts"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./src/tokens.ts"
    },
    "./nativewind": "./nativewind.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "nativewind.cjs",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20",
    "react-native": ">=0.86.0 <0.89.0",
    "nativewind": "^4.2.0",
    "tailwindcss": "^3.4.0",
    "react-native-reanimated": ">=4.5.0 <5",
    "react-native-gesture-handler": ">=2.32.0 <4",
    "react-native-safe-area-context": ">=5.7.0 <6",
    "react-native-svg": ">=15.15.0 <16"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json"
  }
}
